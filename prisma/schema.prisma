generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ANALYST
  CAPTAIN
  LEGEND // "Leyenda": solo lectura (ranking, torneos y, si tiene equipo, los datos de su equipo)
}

enum Position {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
  SUB
}

enum LolTier {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  EMERALD
  DIAMOND
  MASTER
  GRANDMASTER
  CHALLENGER
}

enum TournamentDivision {
  ELITE // ELO promedio Maestro – Retador
  ASCENSO // ELO promedio Platino II – Diamante I
}

enum TournamentStatus {
  REGISTRATION
  ACTIVE
  FINISHED
}

enum EntryStatus {
  ALIVE
  QUALIFIED // llegó a 3 victorias
  ELIMINATED // llegó a 3 derrotas
}

enum ScrimStatus {
  PENDING // enviada, esperando respuesta del rival
  CONFIRMED // aceptada por ambos equipos
  DECLINED // rechazada por el rival
  CANCELLED // cancelada por alguno de los equipos
  COMPLETED // jugada y con resultado registrado
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role
  // Administrador de la app (no de un equipo): puede eliminar cualquier scrim. Solo se crea desde variables de entorno
  isAdmin      Boolean  @default(false)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scrimsCreated Scrim[]        @relation("ScrimCreatedBy")
  events        ScrimEvent[]
  messages      ScrimMessage[]
  chatReads     ChatRead[]
  player        Player? // Leyenda que se unió como jugador con su op.gg

  @@index([teamId])
}

model Team {
  id            String    @id @default(cuid())
  name          String    @unique
  tag           String    @unique
  region        String    @default("LAN")
  color         String    @default("#C8AA6E")
  inviteCode    String    @unique
  rating        Int       @default(0)
  description   String?
  // Imagen del equipo (PNG, JPEG o WebP ya recortada a 256 px). Se guarda en la BD porque Render no tiene disco persistente
  logo          Bytes?
  logoType      String?
  logoUpdatedAt DateTime? // versión de la imagen: cambia la URL para que el navegador no use la anterior
  createdAt     DateTime  @default(now())

  members              User[]
  players              Player[]
  tournamentsOrganized Tournament[]      @relation("TournamentOrganizer")
  tournamentEntries    TournamentEntry[]
  matchesAsA           TournamentMatch[] @relation("MatchTeamA")
  matchesAsB           TournamentMatch[] @relation("MatchTeamB")
  scrimsHome           Scrim[]           @relation("RequesterTeam")
  scrimsAway           Scrim[]           @relation("OpponentTeam")
  proposalsMade        Scrim[]           @relation("ProposalTeam")
  messages             ScrimMessage[]
}

model Scrim {
  id              String  @id @default(cuid())
  requesterTeamId String
  requesterTeam   Team    @relation("RequesterTeam", fields: [requesterTeamId], references: [id], onDelete: Cascade)
  opponentTeamId  String
  opponentTeam    Team    @relation("OpponentTeam", fields: [opponentTeamId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?   @relation("ScrimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  startAt  DateTime
  endAt    DateTime
  games    Int         @default(3)
  status   ScrimStatus @default(PENDING)
  roomLink String?
  notes    String?

  // Propuesta de re-agenda pendiente de aprobación del otro equipo
  proposedStartAt  DateTime?
  proposedEndAt    DateTime?
  proposedGames    Int?
  proposedByTeamId String?
  proposedByTeam   Team?     @relation("ProposalTeam", fields: [proposedByTeamId], references: [id], onDelete: SetNull)

  // Resultado (juegos ganados por cada equipo)
  requesterScore      Int?
  opponentScore       Int?
  ratingDelta         Int? // puntos que ganó o perdió el equipo que propuso el scrim
  opponentRatingDelta Int? // puntos del rival (distinto del anterior cuando un equipo toca el piso de 0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Draft de la serie (se configura desde el chat del scrim)
  draftFearless Boolean @default(false) // los campeones elegidos en un juego no se repiten en la serie
  draftTimer    Boolean @default(true) // 30 s por acción, como en el Mundial

  events     ScrimEvent[]
  messages   ScrimMessage[]
  chatReads  ChatRead[]
  draftGames DraftGame[]

  @@index([requesterTeamId, startAt])
  @@index([opponentTeamId, startAt])
  @@index([status])
}

model ScrimEvent {
  id        String   @id @default(cuid())
  scrimId   String
  scrim     Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([scrimId, createdAt])
}

// Chat del scrim entre el staff de ambos equipos (se abre al aceptarse)
model ScrimMessage {
  id        String   @id @default(cuid())
  scrimId   String
  scrim     Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  system    Boolean  @default(false) // avisos automáticos (scrim aceptado, draft, resultados)
  body      String
  createdAt DateTime @default(now())

  @@index([scrimId, createdAt])
}

// Hasta dónde leyó cada usuario un chat (para los no leídos)
model ChatRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scrimId    String
  scrim      Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([userId, scrimId])
}

enum DraftStatus {
  READY_CHECK // lados elegidos, esperando que ambos equipos estén listos
  DRAFTING
  DONE
}

// Un juego de la serie con su draft (orden profesional: 6 baneos, 6 picks, 4 baneos, 4 picks)
model DraftGame {
  id           String      @id @default(cuid())
  scrimId      String
  scrim        Scrim       @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  number       Int
  blueTeamId   String
  redTeamId    String
  sideChosenBy String // equipo que eligió el lado
  status       DraftStatus @default(READY_CHECK)
  blueReady    Boolean     @default(false)
  redReady     Boolean     @default(false)
  actions      Json        @default("[]") // id del campeón (o null si no baneó) en el orden del draft
  step         Int         @default(0)
  hover        String? // campeón que el equipo en turno tiene seleccionado sin confirmar
  turnEndsAt   DateTime?
  winnerTeamId String?
  matchId      String?     @unique // Game ID de Riot (p. ej. LA1_1234567890) con el que se verificó el ganador
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([scrimId, number])
}

// Jugadores de LoL del equipo (no son usuarios de la plataforma). Se guarda su cuenta principal.
model Player {
  id            String    @id @default(cuid())
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String?   @unique // cuenta de AU Scrims del jugador (Leyenda unida con código)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  gameName      String
  tagLine       String
  opggUrl       String // perfil de op.gg (obligatorio al registrar)
  position      Position
  tier          LolTier?
  division      Int? // 1-4 (null para Maestro+ o sin rango)
  lp            Int       @default(0)
  // Datos sincronizados desde la API oficial de Riot (la misma fuente que usa op.gg)
  puuid         String?   @unique
  summonerLevel Int?
  wins          Int?
  losses        Int?
  rankUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([gameName, tagLine])
  @@index([teamId])
}

// Torneo de formato suizo: 3 victorias clasifican, 3 derrotas eliminan.
model Tournament {
  id              String             @id @default(cuid())
  name            String
  division        TournamentDivision
  status          TournamentStatus   @default(REGISTRATION)
  organizerTeamId String
  organizerTeam   Team               @relation("TournamentOrganizer", fields: [organizerTeamId], references: [id], onDelete: Cascade)
  round           Int                @default(0)
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  entries TournamentEntry[]
  matches TournamentMatch[]

  @@index([division, status])
}

model TournamentEntry {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seed         Int?
  wins         Int         @default(0)
  losses       Int         @default(0)
  status       EntryStatus @default(ALIVE)
  // Foto de la elegibilidad al inscribirse
  ratingAtJoin Int
  eloAtJoin    String
  createdAt    DateTime    @default(now())

  @@unique([tournamentId, teamId])
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  teamAId      String
  teamA        Team       @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId      String? // null = descanso (bye), cuenta como victoria
  teamB        Team?      @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  bestOf       Int        @default(1)
  scoreA       Int?
  scoreB       Int?
  winnerId     String?
  reportedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, round])
}
