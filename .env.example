# Base de datos (docker-compose la levanta en el puerto 5434 del host)
POSTGRES_USER=auscrims
POSTGRES_PASSWORD=auscrims_dev_pw
POSTGRES_DB=auscrims
DB_PORT=5434
APP_PORT=3000

# Para `npm run dev` fuera de Docker
DATABASE_URL=postgresql://auscrims:auscrims_dev_pw@localhost:5434/auscrims?schema=public

# Secreto para firmar las sesiones (mínimo 32 caracteres). CÁMBIALO en producción.
JWT_SECRET=change-me-in-production-please-32chars

# true = cookie solo por HTTPS (actívalo detrás de un proxy con TLS)
COOKIE_SECURE=false

# Carga equipos y scrims de ejemplo al iniciar si la BD está vacía
SEED_DEMO=true
SEED_PASSWORD=Scrims2026!
